title: |md
  # SecOpent
  Authorized pentest workbench · Catalog-driven
|

direction: down

vars: {
  d2-config: {
    layout-engine: dagre
    pad: 30
  }
}

# Linear-inspired palette
classes: {
  lang: {
    style.font-color: "#FFFFFF"
    style.stroke: "#5E6AD2"
    style.stroke-width: 2
    style.border-radius: 8
  }
  runtime: {
    style.font-color: "#FFFFFF"
    style.stroke: "#22C55E"
    style.stroke-width: 1
    style.border-radius: 8
  }
  data: {
    style.font-color: "#FFFFFF"
    style.stroke: "#F59E0B"
    style.stroke-width: 1
    style.border-radius: 8
  }
  ai: {
    style.font-color: "#FFFFFF"
    style.stroke: "#EF4444"
    style.stroke-width: 1
    style.border-radius: 8
  }
  obs: {
    style.font-color: "#FFFFFF"
    style.stroke: "#8B5CF6"
    style.stroke-width: 1
    style.border-radius: 8
  }
}

  python: "Python 3.11" {
    class: lang
    style.fill: "#3776AB"
  }
  fastapi: "FastAPI + Pydantic" {
    class: lang
    style.fill: "#009688"
  }
  sqlalchemy: "SQLAlchemy 2.0" {
    class: runtime
    style.fill: "#D71E00"
  }
  postgres: "PostgreSQL" {
    class: data
    style.fill: "#336791"
  shape: cylinder
  }
  jinja: "Jinja2 templates" {
    class: runtime
    style.fill: "#B41742"
  }
  mcp: "FastMCP stdio + HTTP" {
    class: ai
    style.fill: "#0EA5E9"
  }
  structlog: "structlog 24" {
    class: runtime
    style.fill: "#5E6AD2"
  }
  prom: "Prometheus + OTel" {
    class: obs
    style.fill: "#F46800"
  }
  crypto: "cryptography 42" {
    class: runtime
    style.fill: "#9333EA"
  }

  python -> fastapi
  fastapi -> postgres: "SQL"
  fastapi -> jinja: "render"
  fastapi -> mcp: "tool surface"
  fastapi -> structlog: "logs"
  fastapi -> crypto: "sign findings"
  fastapi -> prom: "metrics"
