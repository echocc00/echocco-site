title: |md
  # strixoc
  Open-source AI penetration testing · Strix fork
|

direction: down

vars: {
  d2-config: {
    layout-engine: dagre
    pad: 30
  }
}

# Linear-inspired palette
classes: {
  lang: {
    style.font-color: "#FFFFFF"
    style.stroke: "#5E6AD2"
    style.stroke-width: 2
    style.border-radius: 8
  }
  runtime: {
    style.font-color: "#FFFFFF"
    style.stroke: "#22C55E"
    style.stroke-width: 1
    style.border-radius: 8
  }
  data: {
    style.font-color: "#FFFFFF"
    style.stroke: "#F59E0B"
    style.stroke-width: 1
    style.border-radius: 8
  }
  ai: {
    style.font-color: "#FFFFFF"
    style.stroke: "#EF4444"
    style.stroke-width: 1
    style.border-radius: 8
  }
  obs: {
    style.font-color: "#FFFFFF"
    style.stroke: "#8B5CF6"
    style.stroke-width: 1
    style.border-radius: 8
  }
}

  python: "Python 3.12+" {
    class: lang
    style.fill: "#3776AB"
  }
  openai_agents: "openai-agents[litellm]" {
    class: ai
    style.fill: "#10A37F"
  }
  litellm: "LiteLLM router" {
    class: ai
    style.fill: "#FF6B35"
  }
  openai: "OpenAI 2.45+" {
    class: ai
    style.fill: "#10A37F"
  }
  pydantic: "Pydantic 2.11+" {
    class: runtime
    style.fill: "#DC2626"
  }
  pyd_settings: "pydantic-settings" {
    class: runtime
    style.fill: "#DC2626"
  }

  python -> openai_agents
  openai_agents -> litellm: "route"
  litellm -> openai: "call"
  openai_agents -> pydantic: "validate"
  openai_agents -> pyd_settings: "config"
