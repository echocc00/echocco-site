    },
    {
      "id": "m2",
      "from": "catalog",
      "to": "operator",
      "y": 260,
      "label": "scope: in · out · pre-approved techniques",
      "variant": "return"
    },
    {
      "id": "m3",
      "from": "operator",
      "to": "agent",
      "y": 360,
      "label": "case state → propose next action",
      "variant": "emphasis"
    },
    {
      "id": "m4",
      "from": "agent",
      "to": "operator",
      "y": 460,
      "label": "proposal: technique · target · payload",
      "variant": "return"
    },
    {
      "id": "m5",
      "from": "operator",
      "to": "sandbox",
      "y": 560,
      "label": "approve · dispatch within scope",
      "variant": "emphasis"
