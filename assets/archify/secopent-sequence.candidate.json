      "label": "Catalog",
      "sublabel": "scope · approvals"
    },
    {
      "id": "agent",
      "type": "cloud",
      "label": "Agent",
      "sublabel": "LLM · proposes only"
    },
    {
      "id": "sandbox",
      "type": "security",
      "label": "Sandbox",
      "sublabel": "seccomp · oracle"
    },
    {
      "id": "findings",
      "type": "database",
      "label": "Findings store",
      "sublabel": "signed · immutable"
    }
  ],
  "messages": [
    {
      "id": "m1",
      "from": "operator",
      "to": "catalog",
      "y": 180,
      "label": "open workbench with credentials",
