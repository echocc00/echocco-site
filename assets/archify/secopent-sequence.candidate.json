    "viewBox": [
      1080,
      920
    ],
    "column_fit": "spread",
    "views": [
      {
        "id": "scope-and-propose",
        "label": "Scope and propose",
        "focus": [
          "operator",
          "catalog",
          "agent"
        ],
        "note": "Operator opens the workbench with catalog-defined scope, then the agent proposes the next action inside that boundary."
      },
      {
        "id": "decide-execute-sign",
        "label": "Decide, execute, sign",
        "focus": [
          "agent",
          "operator",
          "sandbox",
          "findings"
        ],
        "note": "Operator approves the proposal, the deterministic sandbox runs the action, and the signed finding publishes to the catalog."
      }
    ]
  },
  "participants": [
